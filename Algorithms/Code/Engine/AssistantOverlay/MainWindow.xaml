<Window x:Class="AssistantOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Second Brain"
        Height="80" Width="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Grid>
        <!-- Overlay Logo Button -->
        <Ellipse Width="60" Height="60"
                 Fill="#CC1a1a2e"
                 Stroke="#7B2FBE"
                 StrokeThickness="2"
                 Cursor="Hand"
                 MouseLeftButtonDown="Logo_Click"
                 MouseRightButtonDown="Logo_RightClick"/>

        <!-- Brain icon letter -->
        <TextBlock Text="SB"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>