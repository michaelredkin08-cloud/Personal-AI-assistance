<Window x:Class="AssistantOverlay.SaveNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Note — Second Brain"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        Foreground="White"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <!-- Title -->
        <TextBlock Text="Save to Second Brain"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#7B2FBE"
                   Margin="0,0,0,15"/>

        <!-- Selected text preview -->
        <TextBlock Text="Selected text:"
                   Foreground="#aaaaaa"
                   Margin="0,0,0,5"/>
        <TextBox x:Name="SelectedTextBox"
                 Height="80"
                 Background="#2a2a3e"
                 Foreground="White"
                 BorderBrush="#7B2FBE"
                 Padding="8"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True"/>

        <!-- Suggested folder -->
        <TextBlock Text="Suggested folder:"
                   Foreground="#aaaaaa"
                   Margin="0,15,0,5"/>
        <ComboBox x:Name="FolderComboBox"
                  Background="#2a2a3e"
                  Foreground="White"
                  BorderBrush="#7B2FBE"
                  Padding="8"/>

        <!-- Note title -->
        <TextBlock Text="Note title:"
                   Foreground="#aaaaaa"
                   Margin="0,15,0,5"/>
        <TextBox x:Name="TitleBox"
                 Background="#2a2a3e"
                 Foreground="White"
                 BorderBrush="#7B2FBE"
                 Padding="8"/>

        <!-- Flags -->
        <StackPanel Orientation="Horizontal" Margin="0,15,0,15">
            <CheckBox x:Name="HardToRememberBox"
                      Content="Hard to remember"
                      Foreground="White"
                      Margin="0,0,20,0"/>
            <CheckBox x:Name="ImportantBox"
                      Content="Important"
                      Foreground="White"/>
        </StackPanel>

        <!-- Save button -->
        <Button Content="Save Note"
                Background="#7B2FBE"
                Foreground="White"
                FontWeight="Bold"
                Padding="10,8"
                BorderThickness="0"
                Cursor="Hand"
                Click="SaveButton_Click"/>

    </StackPanel>
</Window>